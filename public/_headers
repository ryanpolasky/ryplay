/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-store, must-revalidate

/
  Cache-Control: no-store, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/og.webp
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/icons.svg
  Cache-Control: public, max-age=604800
